# 온라인 모드 네트워크 설정 (모두 선택 사항 — 미설정 시 기본값 사용)
# 실제 값은 .env.local에 두고 커밋하지 않는다.

# 시그널 서버 WebSocket URL. 로컬에서 signal-server를 띄울 때 덮어쓴다.
# 기본값: wss://chunsik-dodge.fly.dev
#VITE_SIGNAL_URL=ws://localhost:8787

# TURN 서버 설정. 쉼표로 구분한 URL 목록.
# 기본값은 openrelay 공개 릴레이인데 동작이 보장되지 않으므로,
# 운영 배포에서는 https://www.metered.ca/tools/openrelay/ 무료 계정(월 50GB)을
# 발급해 아래 값을 채운 뒤 빌드한다. (자체 turn-server/ coturn을 쓸 경우 그 주소로)
#VITE_TURN_URLS=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
#VITE_TURN_USERNAME=your-metered-username
#VITE_TURN_CREDENTIAL=your-metered-credential
